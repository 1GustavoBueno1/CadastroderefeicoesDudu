rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

   function dataValida(data) {
  return data.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
}



    function porRefeicaoValido(m) {
      return  m is map
      && m.keys().hasOnly(['cafeManha', 'almoco', 'cafeTarde', 'janta'])
      && m.keys().hasAll(['cafeManha', 'almoco', 'cafeTarde', 'janta'])
      && m.cafeManha is int && m.cafeManha >= 0
      && m.almoco is int && m.almoco >=0
      && m.cafeTarde is int && m.cafeTarde >= 0
      && m.janta is int && m.janta >= 0;
    }

    function empresaValida(d) {

      return d is map
      && d.keys().hasOnly(['nome', 'precosPadrao', 'ativa'])
      && d.keys().hasAll(['nome', 'precosPadrao', 'ativa'])
      && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 100
      && d.ativa is bool
      && porRefeicaoValido(d.precosPadrao);
    }

    function autorizado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function lancamentoValido(d) {
  return d is map
    && d.keys().hasAll(['quantidades', 'precos', 'totalCentavos'])
    && d.keys().hasOnly(['quantidades', 'precos', 'totalCentavos', 'qtdFotos'])
    && porRefeicaoValido(d.quantidades)
    && porRefeicaoValido(d.precos)
    && d.totalCentavos is int
    && d.totalCentavos == (
         d.quantidades.cafeManha * d.precos.cafeManha
       + d.quantidades.almoco    * d.precos.almoco
       + d.quantidades.cafeTarde * d.precos.cafeTarde
       + d.quantidades.janta     * d.precos.janta
       )
    && (!('qtdFotos' in d) || (d.qtdFotos is int && d.qtdFotos >= 0));
}

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /empresas/{empresaId} {
      allow read: if autorizado();
      allow create, update: if autorizado() && 
      empresaValida(request.resource.data);
      allow delete: if false;

      match /lancamentos/{data} {
  allow read: if autorizado();
  allow create, update: if autorizado()
    && dataValida(data)
    && lancamentoValido(request.resource.data);
  allow delete: if autorizado();
}

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
}